# FlashDrop environment (design §15). For local development: cp .env.example .env
#
# @flashdrop/config validates these at startup and fails fast with a readable list of problems. Connection
# settings default to the local Compose stack on 127.0.0.1, so the infra and the tests need no .env. The
# apps also need the secrets and WORKER_ROLES, which have no defaults. An empty value counts as unset.
#
# Use 127.0.0.1, never localhost: the fd_session cookie is scoped to the host, so mixing the two silently
# drops it on the WebSocket upgrade.

# ---------------------------------------------------------------- Logging
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------- Connections (pnpm infra:up)
# Compose Postgres is on 5433; the native PostgreSQL keeps 5432.
DATABASE_URL=postgres://flashdrop:flashdrop@127.0.0.1:5433/flashdrop
REDIS_URL=redis://127.0.0.1:6379
# Comma-separated host:port list.
KAFKA_BROKERS=127.0.0.1:9092

# ---------------------------------------------------------------- Auth and roles
# Dev-only values, at least 32 characters each. Generate real ones with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# HS256 key for the fd_session cookie (api and web).
SESSION_SECRET=dev-only-session-secret-not-for-production
# Shared by web's internal revalidation route and the worker that calls it.
REVALIDATE_SECRET=dev-only-revalidate-secret-not-for-production
# Roles an api process serves: http, ws.
API_ROLES=http,ws
# Roles a worker process runs: relay, sweeper, reconciler, listing, payment, settlement, dashboard.
# Compose splits them into `worker` (the first four) and `consumers` (the last three).
WORKER_ROLES=relay,sweeper,reconciler,listing,payment,settlement,dashboard
# Origins allowed to open a WebSocket and to send mutating requests.
WS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:8080

# ---------------------------------------------------------------- Service URLs
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_INTERNAL_URL=http://127.0.0.1:3000
# Dev override only: in the full stack the browser derives the socket URL from its location.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:4000/ws
PAYMENT_MOCK_URL=http://127.0.0.1:4100

# ---------------------------------------------------------------- PSP mock
# Simulated latency in ms: a range (uniformly random) or a fixed value.
PSP_LATENCY_MS=100-800
# Probability of a 5xx, and of a timeout after the charge succeeded (both 0 to 1).
PSP_ERROR_RATE=0.02
PSP_TIMEOUT_AFTER_SUCCESS_RATE=0.01

# ---------------------------------------------------------------- LLM listing generator
# anthropic | fixture. Empty: anthropic when ANTHROPIC_API_KEY is set, otherwise the recorded fixtures.
LLM_PROVIDER=
LISTING_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
LISTING_EFFORT=low
# Only needed for live listings and the manual eval; CI never uses one.
ANTHROPIC_API_KEY=
# true: call Anthropic and record the responses as fixtures (needs ANTHROPIC_API_KEY).
LLM_RECORD=false
# Absolute directory for uploaded listing photos, shared by api (writes) and the worker's listing role
# (reads). Empty: flashdrop/uploads in the OS temp directory.
UPLOAD_DIR=

# ---------------------------------------------------------------- Testing and limits
# Mounts /api/v1/test/*; every request must also send the x-test-secret header. Never on a public host.
ENABLE_TEST_ROUTES=false
TEST_ROUTES_SECRET=dev-only-test-routes-secret
# Makes named race-matrix points block on pg_advisory_lock(hookId) in integration tests.
FD_TEST_HOOKS=false
# Reservation rate limits. Load tests raise them, because k6 sends everything from one IP.
RATE_LIMIT_IP_PER_SEC=100
RATE_LIMIT_USER_PER_SEC=10

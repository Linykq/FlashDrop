    LOAD["load-smoke<br/>k6 CI profile:<br/>burst, idempotency-storm<br/>expiry-soak, ws-fanout"]
    SYS["system<br/>failure injection:<br/>checkout-decoupled<br/>relay-kill, safety-net<br/>payments, events<br/>dlq-replay, ws-failover"]

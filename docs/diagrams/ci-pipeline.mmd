  subgraph CI["ci.yml - pull_request and push to main; superseded PR runs cancelled"]
    STATIC["static<br/>install --frozen-lockfile<br/>native binding smoke test<br/>migrations match schema<br/>biome, tsc, vitest unit<br/>next build, no api"]
